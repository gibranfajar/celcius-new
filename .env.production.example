# Template for the real .env file on the server, next to docker-compose.yml.
# Copy to `.env`, fill in the real values, then `docker compose up -d --build`.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time (see
# docker-compose.yml `build.args`), so changing one requires a rebuild
# (`docker compose up -d --build`), not just a container restart.

# Public hostname this storefront is served on. Used by the Traefik router
# label below to know which Host() to match — must already point at this
# server's IP before the first deploy (Let's Encrypt needs it to resolve).
FRONTEND_DOMAIN=shop.clcs.co.id

# Backend API (clcs-backend), reachable from the browser — same host as
# APP_URL in the backend's own .env.production.example.
NEXT_PUBLIC_API_URL=https://cms.clcs.co.id/api/v1

# Midtrans Snap.js — production keys/URL (sandbox ones won't work here).
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_SNAP_URL=https://app.midtrans.com/snap/snap.js
